# ── Employee File Scanner settings ──────────────────────────────────────────
# Copy this file to ".env" (run.bat does this for you) and fill in the values.
# The .env file is git-ignored so your secrets never get committed.

# REQUIRED — your Anthropic API key (Claude reads the scanned forms via vision).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Signs login sessions. run.bat generates a random one automatically if unset.
SECRET_KEY=

# Account creation is ADMIN-ONLY by default (0): the admin adds team members
# from the in-app "Users" page. Set to 1 only if you'd rather let people
# self-register from the login page. The first admin account is always allowed.
ALLOW_REGISTRATION=0

# Uploaded PDFs and generated Excel files are auto-deleted this many days after
# a scan. Set to 0 to keep them forever.
RETENTION_DAYS=30

# Where the app listens:
#   127.0.0.1  = this computer only (most private)
#   0.0.0.0    = also reachable by other computers on your local network (LAN)
HOST=127.0.0.1
PORT=5000

# Optional: model + how many pages of a packet to send to Claude.
ANTHROPIC_MODEL=claude-sonnet-5
EMPLOYEE_MAX_PAGES=20
